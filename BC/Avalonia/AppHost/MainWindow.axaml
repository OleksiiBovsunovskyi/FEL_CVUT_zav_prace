<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appView="using:AppView"
        xmlns:global="clr-namespace:;assembly=AppView"
        xmlns:collumGraph="clr-namespace:AppView.CustomControlls.CollumGraph;assembly=AppView"
        x:Class="AppHost.MainWindow"
        Title="Render" Width="1280" Height="720">
  <DockPanel>
    <Grid>
      <appView:RendererView x:Name="Renderer" />
      <StackPanel Spacing="5" Margin="10,10,0,0">
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" Padding="0,0"
              Background="#99000000" CornerRadius="4" IsHitTestVisible="False">
          <TextBlock Name="InputState" Text="Input state (TAB): __NO INPUT STATE SET__" />
        </Border> <!-- Input state -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" Padding="0,0"
              Background="#99000000" CornerRadius="4" IsHitTestVisible="False">
          <TextBlock Name="RendererStatus" Text="Renderer: starting"/>
        </Border> <!-- Renderer state -->
        <collumGraph:MultiColumnGraph Width="300" Height="60" ColumnWidth="6" ValueMax="100" HorizontalAlignment="Left" Name="TestGraph" />
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="Show vertex pos bits"></TextBlock>
          <CheckBox Name="ShowVertPosBits"></CheckBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="Show meshlets"></TextBlock>
          <CheckBox Name="ShowMeshlets"></CheckBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="Show meshlet bounds"></TextBlock>
          <CheckBox Name="ShowMeshletsBounds"></CheckBox>
        </StackPanel>
        
      </StackPanel>
    </Grid> 
  </DockPanel>
</Window>
