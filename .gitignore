# ---------------------------------------------------------------------------
# Build directories
# ---------------------------------------------------------------------------
build/
out/
bin/
!PGR-sem/framework/*/bin/
cmake-build-*/
[Dd]ebug/
[Rr]elease/
[Rr]elWithDebInfo/
[Mm]inSizeRel/
x64/
x86/
Win32/

# ---------------------------------------------------------------------------
# CMake
# ---------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json
.cmake/

# ---------------------------------------------------------------------------
# Visual Studio / MSBuild
# ---------------------------------------------------------------------------
.vs/
*.vcxproj.user
*.VC.db
*.VC.opendb
*.sln.docstates
*.aps
*.ncb
*.opensdf
*.sdf
*.suo
ipch/

# ---------------------------------------------------------------------------
# CLion / Rider / JetBrains
# The framework ships a committed .idea folder; keep it, ignore local state.
# ---------------------------------------------------------------------------
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/dictionaries/
.idea/**/httpRequests/
.idea/**/.name
cmake-build-debug/
cmake-build-release/

# ---------------------------------------------------------------------------
# VS Code
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json

# ---------------------------------------------------------------------------
# Compiler / linker artifacts
# Vendored prebuilt libraries under PGR-sem/framework/ are tracked on purpose,
# so they are re-included below.
# ---------------------------------------------------------------------------
*.o
*.obj
*.lo
*.slo
*.gch
*.pch
*.ilk
*.idb
*.pdb
*.exp
*.map
*.res
*.tlog
*.iobj
*.ipdb
*.exe
*.out
*.app
*.a
*.lib
*.dll
*.so
*.so.*
*.dylib
!PGR-sem/framework/**/*.a
!PGR-sem/framework/**/*.lib
!PGR-sem/framework/**/*.dll
!PGR-sem/framework/**/*.so
!PGR-sem/framework/**/*.so.*
!PGR-sem/framework/**/*.dylib

# ---------------------------------------------------------------------------
# C++20 module artifacts (.ixx sources are tracked; compiled BMIs are not)
# ---------------------------------------------------------------------------
*.ifc
*.pcm
*.gcm
*.bmi
*.module.json

# ---------------------------------------------------------------------------
# Debug / profiling / crash output
# ---------------------------------------------------------------------------
*.dmp
*.stackdump
*.log
!PGR-sem/**/credits.txt
perf.data*
callgrind.out.*
RenderDoc/
*.rdc

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Editors / misc
# ---------------------------------------------------------------------------
*~
*.swp
*.swo
*.bak
*.orig
*.rej
*.tmp

# ---------------------------------------------------------------------------
# Redundant: framework/ is already tracked extracted, no need for the archive
# ---------------------------------------------------------------------------
/framework.zip

# ---------------------------------------------------------------------------
# Local, machine-specific, or secret
# ---------------------------------------------------------------------------
.env
.env.local
*.local
local.*

# ---------------------------------------------------------------------------
# CLion / IDE state and CMake's Visual Studio generator output
# ---------------------------------------------------------------------------
PGR-sem/src/.idea/
PGR-sem/src/framework/
PGR-sem/src/vk/Docs/
PGR-sem/src/del.cpp
PGR-sem/src/rt_diag.cpp
PGR-sem/src/vk/shaders/Core/gpu_types.slang
