#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "gpu_types.glsl"

/**
 * One workgroup per meshlet; groupCountX is the mesh's meshlet count. No task
 * shader, and nothing culls.
 *
 * max_vertices/max_primitives must be >= ClusterLODSettings'
 * maxVerticesPerCluster/maxTrianglesPerCluster.
 */
layout(local_size_x = 64) in;
layout(triangles, max_vertices = 64, max_primitives = 64) out;

layout(location = 0) out vec3 vNormal[];

void main() {
    GPUMesh mesh = pc.meshes.m[pc.meshIndex];
    GPUMeshlet meshlet = pc.meshlets.m[mesh.meshletOffset + gl_WorkGroupID.x];

    /* Before any output write. These counts are what the rasterizer uses. */
    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);

    for (uint i = gl_LocalInvocationIndex; i < meshlet.vertexCount; i += gl_WorkGroupSize.x) {
        /* meshlet-local -> mesh-local -> global. */
        uint vertexIndex = pc.meshletVertexIndices.i[
            mesh.meshletVertexIndexOffset + meshlet.vertexOffset + i];
        GPUVertex vertex = pc.vertices.v[mesh.vertexOffset + vertexIndex];

        gl_MeshVerticesEXT[i].gl_Position = pc.viewProj * vec4(vertex.position.xyz, 1.0);
        vNormal[i] = vertex.normal.xyz;
    }

    for (uint i = gl_LocalInvocationIndex; i < meshlet.triangleCount; i += gl_WorkGroupSize.x) {
        /* Three 8-bit meshlet-local indices per uint. */
        uint packed = pc.meshletTriangles.i[
            mesh.meshletTriangleOffset + meshlet.triangleOffset + i];

        gl_PrimitiveTriangleIndicesEXT[i] =
            uvec3(packed & 0xffu, (packed >> 8) & 0xffu, (packed >> 16) & 0xffu);
    }
}
