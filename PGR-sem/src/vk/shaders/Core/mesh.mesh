#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "gpu_types.glsl"

// One workgroup per meshlet; build_draw_commands.comp sets groupCountX.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 64) out;

/// Mirror of MeshDrawPush in Core/GPUTypes.ixx.
layout(push_constant, scalar) uniform MeshPush {
    mat4 viewProj;                          // 0

    DrawDataBuffer drawData;                // 64
    ObjectBuffer   objects;                 // 72
    MeshBuffer     meshes;                  // 80
    VertexBuffer   vertices;                // 88
    MeshletBuffer  meshlets;                // 96
    UintBuffer     meshletVertexIndices;    // 104
    UintBuffer     meshletTriangles;        // 112
} pc;                                       // 120

layout(location = 0) out MeshVertex {
    vec3 normal;
} v_out[];

void main() {
    /* Slot handed out by the atomicAdd in build_draw_commands.comp. */
    const GPUDrawData draw   = pc.drawData.d[gl_DrawID];
    const GPUObject   object = pc.objects.o[draw.objectIndex];
    const GPUMesh     mesh   = pc.meshes.m[draw.meshIndex];

    const GPUMeshlet meshlet = pc.meshlets.m[mesh.meshletOffset + gl_WorkGroupID.x];

    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);

    const mat4 mvp = pc.viewProj * object.transform;
    /* Uniform scale is assumed; a non-uniform one needs the inverse transpose. */
    const mat3 normalMatrix = mat3(object.transform);

    const uint vertexBase   = mesh.meshletVertexIndexOffset + meshlet.vertexOffset;
    const uint triangleBase = mesh.meshletTriangleOffset + meshlet.triangleOffset;

    for (uint i = gl_LocalInvocationIndex; i < meshlet.vertexCount; i += 64) {
        const uint      index  = pc.meshletVertexIndices.i[vertexBase + i];
        const GPUVertex vertex = pc.vertices.v[mesh.vertexOffset + index];

        gl_MeshVerticesEXT[i].gl_Position = mvp * vec4(vertex.position.xyz, 1.0);
        v_out[i].normal = normalize(normalMatrix * vertex.normal.xyz);
    }

    for (uint i = gl_LocalInvocationIndex; i < meshlet.triangleCount; i += 64) {
        const uint packed = pc.meshletTriangles.i[triangleBase + i];
        gl_PrimitiveTriangleIndicesEXT[i] =
            uvec3(packed & 0xffu, (packed >> 8) & 0xffu, (packed >> 16) & 0xffu);
    }
}
