          <mxGeometry x="40" y="240" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="Materials — GPUMaterial, 4 MB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="280" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="Clusters — GPUCluster, 8 MB  (CLOD, unused)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="320" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="ClusterGroups — GPUClusterGroup, 4 MB  (CLOD, unused)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="360" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="gh2" value="Per-frame buffers — one buffer per kind per frame slot.&#xa;allocateFrame hands out slices; a slice is never freed alone.&#xa;resetFrame(slot) clears the whole slot at the frame&#39;s start." style="text;html=1;fontStyle=1;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="400" y="20" width="340" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="Objects — GPUObject, host visible + mapped" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="400" y="80" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="DrawData — GPUDrawData, device local" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="400" y="120" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="MeshTaskCommands ×N buckets — INDIRECT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="400" y="160" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="MeshTaskCommandCount ×N buckets — INDIRECT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="400" y="200" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="FrameConstants — no record declared yet" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="400" y="240" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="h6" value="Lights — GPULight does not exist yet" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="400" y="280" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="h7" value="Upload staging — 32 MB, host visible, not per frame slot.&#xa;The CPU write target: a loader memcpys records into a slice of it, UploadBatch records vkCmdCopyBuffer from it into the device-local static buffers. Bump allocated; slices stay taken until submitAndWait waits its fence and calls resetUpload(), which clears all of them." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="400" y="330" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gh3" value="On the GPU" style="text;html=1;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="800" y="40" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s_bdc" value="build_draw_commands.slang (compute)&#xa;reads: Objects, Meshes, Materials&#xa;writes: DrawData, Commands[bucket], Count[bucket]&#xa;one invocation per object, 64 per workgroup" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="800" y="80" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s_mesh" value="mesh.slang meshMain (mesh shader)&#xa;reads: DrawData, Objects, Meshes, Meshlets,&#xa;MeshletVertexIndices, MeshletTriangleIndices, Vertices&#xa;one workgroup per meshlet, ≤64 verts / ≤64 tris" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="800" y="205" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s_frag" value="mesh.slang fragMain (fragment)&#xa;reads: Materials&#xa;planned: Lights, bindless textures" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="800" y="330" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gN1" value="No descriptor sets outside ImGui. Every buffer is reached by its&#xa;64-bit device address, passed in push constants and typed as&#xa;GpuPtr&lt;T&gt; on the C++ side. MeshDrawPush is exactly 128 bytes —&#xa;the guaranteed push constant limit — so the next pointer needs&#xa;a descriptor set or a constants buffer." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="40" y="460" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gN2" value="Single source of truth: every record is declared once in&#xa;Core/GPUTypes.ixx. gen_slang_structs.cmake generates the Slang&#xa;mirror; gen_layout_check.cmake reads the compiled SPIR-V back&#xa;with spirv-dis and emits static_asserts, so a drifting field is a&#xa;build error naming the field." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="560" y="460" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gN3" value="Open problem (notes.md): mega-buffer fragmentation.&#xa;VmaVirtualBlock reuses freed ranges but fragments over time;&#xa;defragmenting means rebuilding and re-uploading. Splitting into&#xa;N smaller buffers trades that for N draw calls.&#xa;Also open: setRetirementSerial / collect are never called, so a&#xa;freed static range is never actually reclaimed." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" parent="1" vertex="1">
          <mxGeometry x="1080" y="460" width="480" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
